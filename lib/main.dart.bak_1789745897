class ForgotPasswordScreen extends StatefulWidget {
  const ForgotPasswordScreen({super.key});

  @override
  State<ForgotPasswordScreen> createState() => _ForgotPasswordScreenState();
}

class _ForgotPasswordScreenState extends State<ForgotPasswordScreen> {
  int _step = 0; // 0=اختيار، 1=كود البريد، 2=Master Key

  final _codeCtrl = TextEditingController();
  final _masterCtrl = TextEditingController();

  String _error = '';
  bool _loading = false;

  // ============ الخيار 1: البريد الاحتياطي ============
  Future<void> _requestEmailCode() async {
    setState(() {
      _error = '';
      _loading = true;
    });

    await Future.delayed(const Duration(seconds: 1));

    if (mounted) {
      setState(() {
        _loading = false;
        _step = 1;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('📧 تم إرسال كود الاستعادة إلى البريد الاحتياطي'),
          backgroundColor: Color(0xFF25D366),
        ),
      );
    }
  }

  Future<void> _verifyEmailCode() async {
    if (_codeCtrl.text.trim().isEmpty) {
      setState(() => _error = 'أدخل الكود');
      return;
    }

    setState(() {
      _error = '';
      _loading = true;
    });

    await Future.delayed(const Duration(seconds: 1));

    if (mounted) {
      setState(() => _loading = false);
      // للتجربة: أي كود يقبل
      if (_codeCtrl.text.length >= 4) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('✅ تم التحقق'),
            backgroundColor: Color(0xFF25D366),
          ),
        );
        Navigator.pop(context);
      } else {
        setState(() => _error = 'الكود غير صحيح');
      }
    }
  }

  // ============ الخيار 2: Master Key ============
  Future<void> _verifyMasterKey() async {
    const masterKey = 'SJ-MASTER-9F3K-2026-XYZ-8877';

    if (_masterCtrl.text.trim() != masterKey) {
      setState(() => _error = 'المفتاح غير صحيح');
      return;
    }

    setState(() {
      _error = '';
      _loading = true;
    });

    await Future.delayed(const Duration(seconds: 1));

    if (mounted) {
      setState(() => _loading = false);
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('🔑 دخول رئيسي مقبول'),
          backgroundColor: Color(0xFF25D366),
        ),
      );
      Navigator.pop(context);
    }
  }

  @override
  void dispose() {
    _codeCtrl.dispose();
    _masterCtrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF2B0013),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        elevation: 0,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back, color: Colors.white),
