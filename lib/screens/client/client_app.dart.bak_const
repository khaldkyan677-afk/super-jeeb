class _SIcon extends StatelessWidget {
  final IconData icon;
  final String label;
  const _SIcon({required this.icon, required this.label});

  void _navigate(BuildContext context) {
    // 🚕 تاكسي → شاشة المواصلات
    if (label == 'تاكسي') {
      Navigator.push(
        context,
        MaterialPageRoute(builder: (_) => const TransportScreen()),
      );
      return;
    }
    // 🆘 فزعة / فرزة → شاشة الخدمات (فزعة)
    if (label == 'فزعة' || label == 'فرزة') {
      Navigator.push(
        context,
        MaterialPageRoute(
          builder: (_) => const ServicesScreen(serviceType: 'fazaa'),
        ),
      );
      return;
    }
    // 📦 طرود → شاشة الخدمات (طرود)
    if (label == 'طرود') {
      Navigator.push(
        context,
        MaterialPageRoute(
          builder: (_) => const ServicesScreen(serviceType: 'parcel'),
        ),
      );
      return;
    }
    // 🏪 باقي الأقسام → شاشة المتاجر المُصفَّاة
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => CategoryShopsScreen(category: label),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: () => _navigate(context),
      borderRadius: BorderRadius.circular(50),
      child: Column(
        children: [
          Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              color: Colors.white,
              shape: BoxShape.circle,
              boxShadow: [
                BoxShadow(color: Colors.black.withValues(alpha: 0.05), blurRadius: 5),
              ],
            ),
            child: Icon(icon, color: const Color(0xFF2B2D42), size: 24),
          ),
          const SizedBox(height: 5),
          Text(label,
              style: const TextStyle(fontSize: 10),
              overflow: TextOverflow.ellipsis),
        ],
      ),
    );
  }
}

