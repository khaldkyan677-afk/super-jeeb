class ClientApp extends StatelessWidget {
  const ClientApp({super.key});

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: SettingsService.instance,
      builder: (context, _) {
        return MaterialApp(
          title: 'Super Jeeb Client',
          debugShowCheckedModeBanner: false,
          theme: SettingsService.instance.darkMode
              ? SettingsService.darkTheme()
              : SettingsService.lightTheme(),
          home: const ClientSplash(),
        );
      },
    );
  }
}

class ClientSplash extends StatefulWidget {
  const ClientSplash({super.key});
  @override
  State<ClientSplash> createState() => _ClientSplashState();
}

class _ClientSplashState extends State<ClientSplash>
    with SingleTickerProviderStateMixin {
  late AnimationController _c;
  late Animation<double> _fade;
  late Animation<double> _scale;

  @override
  void initState() {
    super.initState();
    _c = AnimationController(vsync: this, duration: const Duration(seconds: 2));
    _fade = Tween<double>(begin: 0, end: 1).animate(_c);
    _scale = Tween<double>(begin: 0.5, end: 1).animate(
      CurvedAnimation(parent: _c, curve: Curves.easeOutBack),
    );
    _c.forward();
    Future.delayed(const Duration(seconds: 3), () {
      if (mounted) {
        Navigator.pushReplacement(context,
            MaterialPageRoute(builder: (_) => const ClientMainNav()));
      }
    });
  }

  @override
  void dispose() {
    _c.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF2B2D42),
      body: Center(
        child: FadeTransition(
          opacity: _fade,
          child: ScaleTransition(
            scale: _scale,
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const SJLogo(size: 130),
                const SizedBox(height: 25),
                const Text('Super Jeeb',
                    style: TextStyle(
                        fontSize: 28,
                        fontWeight: FontWeight.bold,
                        color: Colors.white)),
                const SizedBox(height: 10),
                const Text('يجيبها لحد عندك',
                    style: TextStyle(
                        fontSize: 18,
                        color: Color(0xFFEF233C),
                        fontWeight: FontWeight.w500)),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

